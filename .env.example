# ---------------------------------------------------------------------------
# Public app metadata (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Next.js Boilerplate"
NEXT_PUBLIC_APP_DESCRIPTION="Clean Architecture starter for the Next.js App Router"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Which IAIGateway implementation the Chat feature uses: "gemini" | "anthropic"
NEXT_PUBLIC_CHAT_PROVIDER="gemini"

# ---------------------------------------------------------------------------
# Required to sign in
# ---------------------------------------------------------------------------

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Auth.js verifies the request Host in production. Pick one:
#   AUTH_URL         — your canonical origin, e.g. https://app.example.com
#   AUTH_TRUST_HOST  — "true" when a proxy you control sets the Host
# Left as "true" so `pnpm build && pnpm start` works locally out of the box.
AUTH_TRUST_HOST="true"
# AUTH_URL="https://app.example.com"

# Matches docker-compose.yml. Run `docker compose up -d` first.
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# ---------------------------------------------------------------------------
# Feature secrets — validated lazily, per key, in src/lib/env.ts.
# Only the features you actually use need to be filled in.
# ---------------------------------------------------------------------------

# Chat — whichever provider NEXT_PUBLIC_CHAT_PROVIDER selects
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Contact — Notion (POST /api/contact)
NOTION_TOKEN=
NOTION_CONTACT_DATABASE_ID=

# ---------------------------------------------------------------------------
# Billing — Stripe (test mode keys start with sk_test_ / whsec_)
# Local webhooks: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints the STRIPE_WEBHOOK_SECRET to use here.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring price id from your Stripe dashboard (Products → Pricing).
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# ---------------------------------------------------------------------------
# Optional infrastructure — each has a working fallback when unset
# ---------------------------------------------------------------------------

# Email. Unset falls back to the log sender, which prints the reset link to the
# terminal — enough to test password reset without a provider account.
RESEND_API_KEY=
EMAIL_FROM="onboarding@resend.dev"

# Shared rate limiting. Unset falls back to the in-memory limiter, which counts
# per process and is therefore ineffective on a multi-replica deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth. Both must be set for the GitHub provider to appear.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Object storage (S3 / R2 / MinIO). Set S3_ENDPOINT for anything but AWS.
S3_BUCKET=
S3_REGION="auto"
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# First account created by `pnpm db:seed`
# SEED_EMAIL="admin@example.com"
# SEED_PASSWORD="changeme123"
# SEED_NAME="Admin"

# Postgres pool size per instance (default 5)
# DATABASE_POOL_MAX=5

# Client HTTP base URL — empty means "same origin"
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_MOCK_API_URL=
