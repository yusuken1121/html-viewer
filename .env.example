# ---------------------------------------------------------------------------
# Public app metadata (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="HTML Viewer"
NEXT_PUBLIC_APP_DESCRIPTION="Claude が作った HTML をどの端末からでも"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Document store — validated lazily, per key, in src/lib/env.ts
# ---------------------------------------------------------------------------

# "notion" (default) or "local". Local reads the .html files in DOCS_LOCAL_DIR
# and needs no credentials — handy for a first `pnpm dev`.
# DOCS_SOURCE="notion"
# DOCS_LOCAL_DIR="content"

# Notion — see docs/notion-setup.md. Share the database with the integration.
NOTION_TOKEN=
NOTION_DOCS_DATABASE_ID=

# Column names, when yours differ from the defaults (Name / File / Category / Tags)
# NOTION_DOCS_TITLE_PROPERTY="名前"
# NOTION_DOCS_FILE_PROPERTY="ファイル"
# NOTION_DOCS_CATEGORY_PROPERTY="カテゴリ"
# NOTION_DOCS_TAGS_PROPERTY="タグ"
# Only if the database has several data sources (rare)
# NOTION_DOCS_DATA_SOURCE_ID=

# Uploads from the app (/upload). There is no sign-in, so set this before
# deploying to a public URL; the form asks for it once and remembers it.
# Leave empty on localhost to upload without a key.
# DOCS_UPLOAD_SECRET=

# ---------------------------------------------------------------------------
# Collections — each is one Notion database, one page, one API.
# News: /news + POST /api/news.   English: /english + POST /api/english.
# ---------------------------------------------------------------------------

# "notion" (default) or "local". Unset, it follows DOCS_SOURCE, so the one
# switch that lets the app run without credentials covers the feed too.
# NEWS_SOURCE="notion"
# NEWS_LOCAL_FILE="content/news.json"

# Create the database with: pnpm news:init-db <parent page id or URL>
NOTION_NEWS_DATABASE_ID=

# Column names, when yours differ from the defaults
# (Name / File / Category / Tags — same as the AWS/docs database)
# NOTION_NEWS_TITLE_PROPERTY="名前"
# NOTION_NEWS_FILE_PROPERTY="ファイル"
# NOTION_NEWS_CATEGORY_PROPERTY="カテゴリ"
# NOTION_NEWS_TAGS_PROPERTY="タグ"
# Optional date column for custom sort order; omit if the DB has none
# NOTION_NEWS_PUBLISHED_PROPERTY="Published"
# NOTION_NEWS_DATA_SOURCE_ID=

# A key of its own for the news API. Leave empty and DOCS_UPLOAD_SECRET
# guards news too, which is what you want for a single personal key.
# NEWS_API_SECRET=

# Create the database with: pnpm english:init-db <parent page id or URL>
# After copying the AWS database, connect the integration on the copy too.
NOTION_ENGLISH_DATABASE_ID=

# ENGLISH_SOURCE / ENGLISH_LOCAL_FILE work exactly like the news pair above.
# ENGLISH_SOURCE="notion"
# ENGLISH_LOCAL_FILE="content/english.json"
# NOTION_ENGLISH_TITLE_PROPERTY="名前"
# NOTION_ENGLISH_FILE_PROPERTY="ファイル"
# NOTION_ENGLISH_CATEGORY_PROPERTY="カテゴリ"
# NOTION_ENGLISH_TAGS_PROPERTY="タグ"
# Optional date column for custom sort order; omit if the DB has none
# NOTION_ENGLISH_PUBLISHED_PROPERTY="Published"
# NOTION_ENGLISH_DATA_SOURCE_ID=
# ENGLISH_API_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Client HTTP base URL — empty means "same origin"
# NEXT_PUBLIC_API_URL=
