# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template MUST be committed, or a fresh clone has nothing to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing (e2e)
/playwright-report
/test-results
/blob-report
/playwright/.cache

# local document store (DOCS_SOURCE=local) — personal files, not source
/content/
# where the local store puts documents deleted through the UI
/e2e/fixtures/.trash/
# the local collections, written by `pnpm dev` and the e2e suite
/e2e/fixtures/news.json
/e2e/fixtures/news.trash.json
/e2e/fixtures/english.json
/e2e/fixtures/english.trash.json
/e2e/fixtures/history.json
/e2e/fixtures/history.trash.json
